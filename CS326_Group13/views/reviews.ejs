<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head') %>
  </head>
  <body class="min-h-screen bg-stone-50 font-sans text-stone-900 antialiased">
    <div class="mx-auto max-w-3xl px-4 py-6 sm:px-6 sm:py-10">
      <header
        class="mb-8 flex flex-col gap-3 border-b-2 border-maroon pb-4 sm:flex-row sm:items-center sm:justify-between"
      >
        <h1 class="text-2xl font-bold tracking-tight text-maroon sm:text-3xl">
          <%= title %>
        </h1>
        <nav
          class="flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-stone-600"
        >
          <a class="hover:text-maroon hover:underline" href="/">Home</a>
          <a class="hover:text-maroon hover:underline" href="/members"
            >Members</a
          >
          <a class="hover:text-maroon hover:underline" href="/students"
            >Students</a
          >
          <a class="hover:text-maroon hover:underline" href="/reviews"
            >Reviews</a
          >
          <a class="hover:text-maroon hover:underline" href="/login">Login</a>
          <a class="hover:text-maroon hover:underline" href="/register"
            >Create Account</a
          >
        </nav>
      </header>
      <main>
        <form
          id="entry-form"
          class="mb-2 flex flex-col gap-2 sm:flex-row"
          hx-post="/reviews"
          hx-target="#entries"
          hx-swap="beforeend"
          hx-on::after-request="if(event.detail.successful) { this.reset(); document.getElementById('form-error').textContent = ''; }"
        >
          <input
            class="rounded border border-stone-300 bg-white px-3 py-2 text-sm focus:border-maroon focus:ring-2 focus:ring-maroon/30 focus:outline-none sm:flex-1"
            type="text"
            name="course"
            placeholder="Course (e.g. CS326)"
          />
          <input
            class="rounded border border-stone-300 bg-white px-3 py-2 text-sm focus:border-maroon focus:ring-2 focus:ring-maroon/30 focus:outline-none sm:w-36"
            type="number"
            name="rating"
            min="1"
            max="5"
            placeholder="Workload 1-5"
          />
          <input
            class="rounded border border-stone-300 bg-white px-3 py-2 text-sm focus:border-maroon focus:ring-2 focus:ring-maroon/30 focus:outline-none sm:flex-1"
            type="text"
            name="comment"
            placeholder="Comment"
          />
          <button
            class="rounded bg-maroon px-4 py-2 text-sm font-semibold text-white hover:bg-maroon-dark disabled:opacity-50"
            type="submit"
          >
            Add review
          </button>
        </form>
        <p
          id="form-error"
          class="mb-4 min-h-5 text-sm text-red-600"
          role="alert"
        ></p>
        <ul id="entries" class="flex flex-col gap-3">
          <% Reviews.forEach((entry) => { %> <%- include('partials/review_row',
          { entry: entry }) %> <% }); %>
        </ul>
      </main>
    </div>
  </body>
</html>
