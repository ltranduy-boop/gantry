<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <header class="site-header">
      <h1><%= student.name %> Profile </h1>
      <nav>
        <a href="/">Home</a>
        <a href="/students">Students</a>
        <a href="/reviews"> Reviews </a>
      </nav>
    </header>
    <main>
      <ul id="entries">
          <li data-id="<%= student.id %>" data-title="<%= student.name %>" data-body="<%= student.major %>">
            <span class="entry-display"><strong><%= student.name %>:</strong> <%= student.major %></span>
            <button class="edit-btn" type="button">Edit</button>
            <button class="delete-btn" type="button">Delete</button>
          </li>
      </ul>
    </main>
    <script src="/app.js" defer></script>
  </body>
</html>
