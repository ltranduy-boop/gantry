<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>Dashboard</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <header class="site-header">
      <h1>Dashboard</h1>
    </header>
    <ul>
      <% sites.forEach(site => { %>
        <li class="site-card">Site: <%= site.name %> - Type: <%= site.type %> - Acres: <%= site.acres %></li>
      <% }); %>
    </ul>
  </body>
</html>
